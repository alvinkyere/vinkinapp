{
  "name": "vinkin",
  "private": true,
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "docker compose up -d && pnpm --filter @vinkin/api migrate && pnpm --filter @vinkin/api dev",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs}\"",
    "guard": "node tooling/scripts/check-provider-imports.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  }
}
