# Copy to .env for local development. Never commit .env (gitignored).
# This file documents apps/api's config (apps/api/src/config/env.ts is the source of truth —
# ENG4 Slice 1 found this file had drifted stale, missing most real vars; re-synced here).
# apps/guest-web and apps/operations-console have their own small NEXT_PUBLIC_* config —
# see apps/guest-web/lib/env.ts and apps/operations-console/lib/env.ts.

VINKIN_ENV=development
PORT=3000
DATABASE_URL=postgres://vinkin:vinkin@localhost:5432/vinkin
REDIS_URL=redis://localhost:6379
# ≥ 32 chars. The checked-in default works only in development/test; staging/production refuse it.
JWT_SECRET=dev-only-secret-change-me-0123456789ab
LOG_LEVEL=info
# Set to 1 to start the OpenTelemetry NodeSDK (requires an OTLP collector).
VINKIN_OTEL_ENABLED=0

# Shared operator credential for the ops console (D17). The checked-in default is refused in
# the `demo` environment (the one place a real operator uses it).
OPERATOR_PASSWORD=dev-only-operator-password
# CORS-allowed origins for the two browser-facing clients.
VINKIN_PUBLIC_BASE_URL=http://localhost:3100
OPERATIONS_CONSOLE_BASE_URL=http://localhost:3200

# Vink lifecycle timing (Spec §14) — real config, not hardcoded constants (ENG1).
VINK_OPEN_DURATION_SECONDS=86400
VINK_PROCESSING_GRACE_SECONDS=60
VINK_SWEEP_INTERVAL_SECONDS=10
GUEST_RESEND_COOLDOWN_SECONDS=60

# Static, default-off feature flags — each documented in detail in env.ts itself.
VINKIN_CONTRIBUTION_PROJECTION_ENABLED=0
VINKIN_PARTICIPANT_INCLUSIVE_RETRIEVAL=0
VINKIN_INVITES_ENABLED=0
# Boot-refused outside development/test — no real delivery provider is selected yet.
VINKIN_AUTOMATIC_INVITATION_DELIVERY_ENABLED=0

# Unset by default (no enforcement). Set to "major.minor.patch" to reject older clients with 426.
# VINKIN_MINIMUM_APP_VERSION=
