# Copy to .env for local development. Never commit .env (gitignored).
# This file documents apps/api's config (apps/api/src/config/env.ts is the source of truth —
# ENG4 Slice 1 found this file had drifted stale, missing most real vars; re-synced here).
# apps/guest-web and apps/operations-console have their own small NEXT_PUBLIC_* config —
# see apps/guest-web/lib/env.ts and apps/operations-console/lib/env.ts.

VINKIN_ENV=development
PORT=3000
DATABASE_URL=postgres://vinkin:vinkin@localhost:5432/vinkin
REDIS_URL=redis://localhost:6379
# ≥ 32 chars. The checked-in default works only in development/test; staging/production refuse it.
JWT_SECRET=dev-only-secret-change-me-0123456789ab
LOG_LEVEL=info
# Set to 1 to start the OpenTelemetry NodeSDK (requires an OTLP collector).
VINKIN_OTEL_ENABLED=0

# Shared operator credential for the ops console (D17). The checked-in default is refused in
# the `demo` environment (the one place a real operator uses it).
OPERATOR_PASSWORD=dev-only-operator-password
# CORS-allowed origins for the two browser-facing clients.
VINKIN_PUBLIC_BASE_URL=http://localhost:3100
OPERATIONS_CONSOLE_BASE_URL=http://localhost:3200
# The API's own externally-reachable origin (ENG5 Slice 1) — used to build the
# email-verification confirm link, a plain API route a browser hits directly.
VINKIN_API_PUBLIC_BASE_URL=http://localhost:3000

# Vink lifecycle timing (Spec §14) — real config, not hardcoded constants (ENG1).
VINK_OPEN_DURATION_SECONDS=86400
VINK_PROCESSING_GRACE_SECONDS=60
VINK_SWEEP_INTERVAL_SECONDS=10
GUEST_RESEND_COOLDOWN_SECONDS=60

# Static, default-off feature flags — each documented in detail in env.ts itself.
VINKIN_CONTRIBUTION_PROJECTION_ENABLED=0
VINKIN_PARTICIPANT_INCLUSIVE_RETRIEVAL=0
VINKIN_INVITES_ENABLED=0
# RM4D — the real delivery provider (Resend). Set both to construct ResendDeliveryProvider
# instead of MockDeliveryProvider; leave unset for the mock (today's exact prior behavior).
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=VinkIn <hello@vinkin.org>
# Boot-refused outside development/test unless RESEND_API_KEY/RESEND_FROM_EMAIL are set (RM4D).
VINKIN_AUTOMATIC_INVITATION_DELIVERY_ENABLED=0
# ENG5 Slice 1 — same boot-refusal reason as the flag immediately above.
VINKIN_EMAIL_VERIFICATION_ENABLED=0
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# ENG5 Slice 2 — same boot-refusal reason again; a separate flag from email verification
# (independently rollout-able).
VINKIN_PASSWORD_RESET_ENABLED=0
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
# ENG5 Slice 3 — same boot-refusal reason again; a separate flag from its two siblings.
VINKIN_MAGIC_LINK_ENABLED=0
MAGIC_LINK_TOKEN_TTL_SECONDS=900
MAGIC_LINK_RESEND_COOLDOWN_SECONDS=60
# ENG5 Slice 4 — same boot-refusal discipline, different underlying reason: no real Apple
# Developer "Sign in with Apple" capability is configured yet (not a delivery dependency —
# this feature sends no email). APPLE_SIGN_IN_CLIENT_ID unset means the route fails closed
# (503) even if the flag were on.
VINKIN_APPLE_SIGN_IN_ENABLED=0
# APPLE_SIGN_IN_CLIENT_ID=
# ENG5 Slice 5 — same discipline again; no real Google Cloud OAuth client configured yet.
VINKIN_GOOGLE_SIGN_IN_ENABLED=0
# GOOGLE_SIGN_IN_CLIENT_ID=

# RM4C (D49) — set to stripe_sandbox to drive real participant card payments through a real
# Stripe sandbox account instead of MockFinancialProvider. Leave at mock for today's exact
# prior behavior (default, unchanged, everywhere including CI). Card-pool/wallet-provisioning
# commands (RM2/RM3B) will visibly throw NOT_SUPPORTED in stripe_sandbox mode — see env.ts's
# own doc comment.
VINKIN_FINANCIAL_PROVIDER=mock
# Required (and must be sk_test_.../pk_test_...) only when VINKIN_FINANCIAL_PROVIDER=stripe_sandbox.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# Mounts the sandbox webhook route (D46) — needs the three Stripe vars above regardless of
# VINKIN_FINANCIAL_PROVIDER, since webhook verification and command execution are separate
# provider instances (D15).
VINKIN_STRIPE_WEBHOOKS_ENABLED=0

# Unset by default (no enforcement). Set to "major.minor.patch" to reject older clients with 426.
# VINKIN_MINIMUM_APP_VERSION=
