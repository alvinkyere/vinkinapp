# Copy to .env for local development. Never commit .env (gitignored).
VINKIN_ENV=development
PORT=3000
DATABASE_URL=postgres://vinkin:vinkin@localhost:5432/vinkin
REDIS_URL=redis://localhost:6379
# ≥ 32 chars. The checked-in default works only in development/test; production refuses it.
JWT_SECRET=dev-only-secret-change-me-0123456789ab
# Set to 1 to start the OpenTelemetry NodeSDK (requires an OTLP collector).
VINKIN_OTEL_ENABLED=0
