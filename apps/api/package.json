{
  "name": "@vinkin/api",
  "version": "0.0.1",
  "private": true,
  "description": "VinkIn API — transport layer (PV1). Health, auth, logging; no business logic (D13).",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/db/check-schema.ts && node src/server.ts",
    "migrate": "node src/db/migrate.ts",
    "seed": "node src/seed.ts",
    "worker": "node src/db/check-schema.ts && node src/jobs/worker.ts",
    "schema:check": "node src/db/check-schema.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:eng9-infra-restart": "node --test src/eng9-infra-restart.manual.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/websocket": "^11.3.4",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-prometheus": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@sentry/node": "^11.9.0",
    "bullmq": "^6.4.2",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
